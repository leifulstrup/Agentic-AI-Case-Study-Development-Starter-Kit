# macOS
.DS_Store
.DS_Store?
.AppleDouble
.LSOverride

# Logs — stray logs are noise, but the GATE logs are the audit trail.
#
# This pattern was originally added to exclude verification-skill output. Field
# testing showed that to be backwards: the assessment and verification logs are
# the evidence that the go/no-go gates ran and what they concluded. Of two cases
# built the same week, one committed its gate logs only because the operator
# noticed and forced the add; the other committed none and its audit trail is
# gone. For a kit whose claim is that its output can be defended, the record of
# the defence is the last thing to discard by default.
*.log
!assess-*.log
!verify-*.log
!coach-*.log
!scout-*.log

# Python (if using simulations)
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
venv/
env/

# Node (if using markdown linting locally)
node_modules/

# Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Temporary files
*.tmp
*.temp

# PDF exports (keep folder, ignore contents for privacy)
# Uncomment if you want to exclude PDFs from git:
# exports/*.pdf

# Sensitive files
.env
.env.local
*.pem
*.key

# Eval fixture source corpora (copyright — keep local, commit only the manifest)
maintainer/evals/fixtures/*/sources/
maintainer/evals/fixtures/*/golden/
